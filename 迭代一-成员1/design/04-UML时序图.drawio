      <mxCell id="seq-03-search-favorite_fr1" value="loop  [分页：每页 pageSize 条]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeColor=#444444;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="27" y="346" width="1491" height="172" as="geometry"/></mxCell>
      <mxCell id="seq-03-search-favorite_g1_0" value="while 还有下一页：按 pageNo 拼 LIMIT pageSize OFFSET (pageNo-1)*pageSize" style="text;html=1;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="35" y="370" width="560" height="16" as="geometry"/></mxCell>
