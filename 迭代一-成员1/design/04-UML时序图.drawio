      <mxCell id="seq-05-review-credit_m10" value="11: insert(credit_log，score_after 快照)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.4078;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4078;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_svc" target="seq-05-review-credit_clog"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-05-review-credit_m11" value="12: insert(REVIEW 操作日志)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.4411;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4411;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_svc" target="seq-05-review-credit_olog"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-05-review-credit_m12" value="13: commit()" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.4745;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4745;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_svc" target="seq-05-review-credit_db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-05-review-credit_m13" value="14: Review（评价成功）" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;strokeColor=#666666;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5079;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5079;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_svc" target="seq-05-review-credit_frame"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-05-review-credit_m14" value="15: throw BusinessRuleException（BR-08：非 DONE、非参与方或自评）" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;strokeColor=#B20000;fontColor=#B20000;fontStyle=1;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5412;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5412;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_svc" target="seq-05-review-credit_frame"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-05-review-credit_m15" value="16: throw DuplicateEntityException（DUP-041：同一流转已评价）" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;strokeColor=#B20000;fontColor=#B20000;fontStyle=1;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5746;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5746;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_svc" target="seq-05-review-credit_frame"><mxGeometry relative="1" as="geometry"/></mxCell>
