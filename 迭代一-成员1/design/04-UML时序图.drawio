      <mxCell id="seq-01-register-login_fr0" value="opt  [用户名或学号已存在]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeColor=#444444;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="27" y="238" width="1191" height="136" as="geometry"/></mxCell>
      <mxCell id="seq-01-register-login_g0_0" value="[existsByUsername / existsByStudentNo == true]" style="text;html=1;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="35" y="262" width="560" height="16" as="geometry"/></mxCell>
      <mxCell id="seq-01-register-login_g0_1" value="→ throw DuplicateEntityException（DUP-001），注册终止" style="text;html=1;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#B20000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="279" width="560" height="16" as="geometry"/></mxCell>
      <mxCell id="seq-01-register-login_fr1" value="alt  [登录结果：成功 / 密码错误 / 锁定期内]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeColor=#444444;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="27" y="706" width="1191" height="316" as="geometry"/></mxCell>
      <mxCell id="seq-01-register-login_g1_0" value="[成功] verify=true 且 lockedUntil 已过期 → 21 updateLoginSuccess、22 写日志、23 返回 LoginResult" style="text;html=1;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="35" y="730" width="560" height="16" as="geometry"/></mxCell>
      <mxCell id="seq-01-register-login_g1_1" value="[失败] verify=false → 21 updateFailCount+1；达到 5 次写入 locked_until = now + 15 分钟" style="text;html=1;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="35" y="747" width="560" height="16" as="geometry"/></mxCell>
      <mxCell id="seq-01-register-login_g1_2" value="[锁定] lockedUntil &amp;gt; now → 直接 throw LOCK-001，提示剩余分钟数（即使密码正确也拒绝）" style="text;html=1;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#B20000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="764" width="560" height="16" as="geometry"/></mxCell>
