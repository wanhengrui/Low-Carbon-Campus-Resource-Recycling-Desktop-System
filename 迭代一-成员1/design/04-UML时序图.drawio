      <mxCell id="seq-02-publish-item_g0_0" value="[creditScore &amp;lt; 60] → throw BusinessRuleException（BR-04），提示“信用分不足，暂不能发布”" style="text;html=1;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#B20000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="226" width="560" height="16" as="geometry"/></mxCell>
