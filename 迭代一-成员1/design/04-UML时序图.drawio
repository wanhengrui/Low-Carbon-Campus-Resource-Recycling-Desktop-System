      <mxCell id="seq-02-publish-item_m0" value="1: 填写标题/描述/价格/成色，选择分类与图片" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.0741;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0741;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_user" target="seq-02-publish-item_frame"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m1" value="2: publish(item, imagePaths)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1075;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1075;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_frame" target="seq-02-publish-item_ctrl"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m2" value="3: publish(item, imagePaths)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1409;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1409;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_ctrl" target="seq-02-publish-item_svc"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m3" value="4: 信用分校验 owner.creditScore ≥ 60（BR-04）" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1742;exitDx=0;exitDy=0;entryX=1;entryY=0.2142;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_svc" target="seq-02-publish-item_svc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="636" y="218"/><mxPoint x="636" y="234"/></Array></mxGeometry></mxCell>
      <mxCell id="seq-02-publish-item_m4" value="5: validateItem(item)（标题 2–50 字、描述 ≤500 字、价格 ≥0）（BR-01）" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.2076;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2076;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_svc" target="seq-02-publish-item_val"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m5" value="6: 校验通过" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;strokeColor=#666666;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.241;exitDx=0;exitDy=0;entryX=0.5;entryY=0.241;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_val" target="seq-02-publish-item_svc"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m6" value="7: 图片校验：仅 jpg/png、单张 ≤2MB、最多 5 张（BR-12）" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2743;exitDx=0;exitDy=0;entryX=1;entryY=0.3143;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_svc" target="seq-02-publish-item_svc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="636" y="326"/><mxPoint x="636" y="342"/></Array></mxGeometry></mxCell>
      <mxCell id="seq-02-publish-item_m7" value="8: beginTransaction()" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.3077;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3077;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_svc" target="seq-02-publish-item_db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m8" value="9: insert(item)（回填 itemId）" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.3411;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3411;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_svc" target="seq-02-publish-item_idao"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m9" value="10: batchInsert(images)（相对路径 data/images/{itemId}/{uuid}.jpg）" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.3744;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3744;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_svc" target="seq-02-publish-item_imgdao"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m10" value="11: insert(PUBLISH_ITEM 操作日志)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.4078;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4078;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_svc" target="seq-02-publish-item_olog"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m11" value="12: commit()" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.4411;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4411;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_svc" target="seq-02-publish-item_db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m12" value="13: publish(ItemPublishedEvent)（观察者异步通知）" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;strokeColor=#666666;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.4745;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4745;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_svc" target="seq-02-publish-item_bus"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m13" value="14: Item（status=ON_SALE）" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;strokeColor=#666666;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5079;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5079;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_svc" target="seq-02-publish-item_ctrl"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-02-publish-item_m14" value="15: 发布成功，跳转“我的物品”" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;strokeColor=#666666;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5412;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5412;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-02-publish-item_ctrl" target="seq-02-publish-item_frame"><mxGeometry relative="1" as="geometry"/></mxCell>
