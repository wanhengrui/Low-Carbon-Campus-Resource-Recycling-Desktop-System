      <mxCell id="seq-05-review-credit_m8" value="9: 分档：score ≥ 4 → +credit.trade_bonus(2)；score ≤ 2 → +credit.bad_review_penalty(−5)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3411;exitDx=0;exitDy=0;entryX=1;entryY=0.3811;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_svc" target="seq-05-review-credit_svc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="486" y="398"/><mxPoint x="486" y="414"/></Array></mxGeometry></mxCell>
