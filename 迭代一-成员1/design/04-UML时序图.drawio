      <mxCell id="seq-02-publish-item_g1_0" value="[非 jpg/png 或单张 &amp;gt;2MB 或数量 &amp;gt;5] → throw ValidationException（VAL-012）" style="text;html=1;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#B20000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="334" width="560" height="16" as="geometry"/></mxCell>
