      <mxCell id="seq-05-review-credit_m1" value="2: review(flowId, reviewerId, score, content)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1075;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1075;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_frame" target="seq-05-review-credit_svc"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-05-review-credit_m2" value="3: findById(flowId)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1409;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1409;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_svc" target="seq-05-review-credit_fdao"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-05-review-credit_m3" value="4: TradeFlow(status=DONE)（BR-08）" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;strokeColor=#666666;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1742;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1742;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_fdao" target="seq-05-review-credit_svc"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="seq-05-review-credit_m4" value="5: existsByFlowAndReviewer(flowId, reviewerId)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=9;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.2076;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2076;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-05-review-credit_svc" target="seq-05-review-credit_rdao"><mxGeometry relative="1" as="geometry"/></mxCell>
