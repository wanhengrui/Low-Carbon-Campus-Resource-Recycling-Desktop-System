    <diagram id="er" name="ER图">
        <mxGraphModel dx="3532" dy="5492" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1450" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f3864;" value="低碳校园资源循环流转系统（GreenCampus Recycle）—— 实体关系图（ER 图）· 11 个实体 / 18 条关系" vertex="1">
                    <mxGeometry height="40" width="1200" x="40" y="-1150" as="geometry"/>
                </mxCell>
                <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;" value="图例：字段行格式为“字段名 : 类型 [约束]”；[PK] 为主键；[FK→表.字段] 为外键；[UQ] 为唯一约束。关系线为鸦爪（crow&#39;s foot）表示法：源端 1（ERone）、目标端 N/0..N（ERmany），连线两端锚定具体字段。trade_flow.item_id 上的部分唯一索引 uq_flow_item_active 保证同一物品最多一条进行中流转；第 3 轮（契约 v1.1）起 item.status 默认 PENDING，且 item 表级约束 ck_item_free_price 要求 trade_type=FREE 时 price 必须为 0（Service + DB 双层校验）。" vertex="1">
                    <mxGeometry height="120" width="1560" x="85" y="200" as="geometry"/>
                </mxCell>
